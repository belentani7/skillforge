#!/usr/bin/env python3
"""
⚒️ SkillForge — The Universal AI Skill Package Manager
Install coding skills into Claude Code, Codex, Aider, Qwen Code, and Gemini CLI.
Write once. Use everywhere.
"""
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
import textwrap
from pathlib import Path

# ── Bootstrap paths ───────────────────────────────────────────
FORGE_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(FORGE_DIR))

from engine.installer import Installer
from engine.registry import Registry
from engine.converters import ConverterEngine

# ── Constants ─────────────────────────────────────────────────
VERSION = "1.0.0"
DB_PATH = FORGE_DIR / "local.db"
CONFIG_PATH = FORGE_DIR / "config" / "default.yaml"
USER_CONFIG_PATH = FORGE_DIR / "config" / "user.yaml"


def get_db() -> sqlite3.Connection:
    """Get or create the local SQLite cache."""
    db = sqlite3.connect(str(DB_PATH))
    # Always ensure schema exists (CREATE IF NOT EXISTS is idempotent)
    schema_path = FORGE_DIR / "database" / "schema.sql"
    if schema_path.exists():
        db.executescript(schema_path.read_text(encoding="utf-8"))
        db.commit()
    return db


def load_config() -> dict:
    """Load configuration (user overrides default)."""
    config = _parse_simple_yaml(CONFIG_PATH)
    if USER_CONFIG_PATH.exists():
        user = _parse_simple_yaml(USER_CONFIG_PATH)
        config.update(user)
    return config


def _parse_simple_yaml(path: Path) -> dict:
    """Read the small flat/one-level config subset without losing tool flags.

    This is intentionally not a general YAML parser. Unsupported structures
    must not silently enable disabled tools.
    """
    result = {}
    if not path.exists():
        return result

    def scalar(raw: str):
        value = raw.strip().strip('"').strip("'")
        if value.lower() == "true":
            return True
        if value.lower() == "false":
            return False
        if value.isdigit():
            return int(value)
        return value

    section = None
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        if indent == 0:
            if ":" not in stripped:
                continue
            key, _, raw = stripped.partition(":")
            key = key.strip()
            if not raw.strip():
                result[key] = {}
                section = key
            else:
                result[key] = scalar(raw)
                section = None
        elif section and stripped.startswith("- "):
            if result[section] == {}:
                result[section] = []
            if isinstance(result[section], list):
                result[section].append(scalar(stripped[2:]))
        elif section and ":" in stripped and isinstance(result[section], dict):
            key, _, raw = stripped.partition(":")
            result[section][key.strip()] = scalar(raw)
    return result

def print_banner():
    """Print the forge ASCII art banner."""
    banner_path = FORGE_DIR / "ascii" / "forge.txt"
    if banner_path.exists():
        print(banner_path.read_text(encoding="utf-8"))
    else:
        print("⚒️  SkillForge")


def print_skill_card(skill: dict):
    """Pretty-print a skill result."""
    name = skill.get("name", "unknown")
    version = skill.get("version", "?.?.?")
    author = skill.get("author", "unknown")
    desc = skill.get("description", "No description")
    stars = skill.get("stars")

    print(f"  ⚒️  {name} v{version}")
    print(f"     by {author}")
    print(f"     {desc}")
    tags = skill.get("tags", [])
    if tags:
        print(f"     🏷️  {', '.join(tags)}")
    if isinstance(stars, int) and stars >= 0:
        print(f"     ⭐ {stars} GitHub stars")
    print()


# ── Commands ──────────────────────────────────────────────────

def cmd_search(args):
    """Search the grimoire for skills."""
    query = args.query
    print(f"\n🔍 Searching the grimoire for \"{query}\"...\n")

    registry = Registry(get_db(), load_config())
    results = registry.search(query)

    if not results:
        print("  No spells found matching your query.")
        print("  Try a different search term or browse popular skills:")
        print("  skillforge search review")
        return

    print(f"  Found {len(results)} spell(s):\n")
    for skill in results:
        print_skill_card(skill)

    print(f"  Install with: skillforge install <name>")


def cmd_install(args):
    """Install a skill into all detected AI tools."""
    name = args.skill
    print(f"\n⚒️  Forging spell: {name}...\n")

    config = load_config()
    db = get_db()
    registry = Registry(db, config)
    installer = Installer(db, config)

    # Fetch skill from registry
    skill = registry.fetch(name)
    if not skill:
        print(f"  ❌ Spell \"{name}\" not found in the grimoire.")
        print(f"  Try: skillforge search {name}")
        return

    # Detect active tools
    tools = installer.detect_tools()
    if not tools:
        print("  ⚠️  No AI tools detected. Nothing was installed.")
        print("  Configure an AI tool first, then retry.")
        return

    # Convert and install for each tool
    converter = ConverterEngine()
    installed_to = []

    for tool in tools:
        tool_config = config.get("tools", {}).get(tool, True)
        if tool_config is False:
            print(f"  ⬜ {tool} (disabled in config)")
            continue

        try:
            content = converter.convert(skill, tool)
            path = installer.install(tool, name, content)
            installed_to.append(f"  ✅ {tool} → {path}")
        except Exception as e:
            installed_to.append(f"  ❌ {tool} → {e}")

    # Do not advertise a skill as installed when every filesystem write failed.
    success_count = len([line for line in installed_to if "✅" in line])
    if success_count:
        registry.record_install(name, skill.get("version", "1.0.0"))

    print("  Installed to:")
    for line in installed_to:
        print(line)
    print(f"\n  ⚒️  Spell \"{name}\" is now active in {success_count} tool(s).")


def cmd_list(args):
    """List installed skills."""
    print("\n📜 Installed Spells:\n")

    db = get_db()
    cursor = db.execute(
        "SELECT name, version, installed_at, tools_installed "
        "FROM installed_skills ORDER BY installed_at DESC"
    )
    rows = cursor.fetchall()

    if not rows:
        print("  No spells installed yet.")
        print("  Search the grimoire: skillforge search <query>")
        return

    for name, version, installed_at, tools_json in rows:
        tools = json.loads(tools_json) if tools_json else []
        tool_icons = " ".join(f"[{t}]" for t in tools)
        print(f"  ⚒️  {name} v{version}  {tool_icons}")
        print(f"     installed {installed_at}")
        print()

    print(f"  Total: {len(rows)} spell(s)")


def cmd_uninstall(args):
    """Remove a skill from all tools."""
    name = args.skill
    print(f"\n🔥 Unforging spell: {name}...\n")

    config = load_config()
    db = get_db()
    installer = Installer(db, config)

    removed = installer.uninstall(name)
    # Files changed by a user or inherited from older versions remain tracked.
    # Removing one tool's file must not make the other protected copies invisible.
    from engine.installed_state import reconcile_after_uninstall
    remaining = reconcile_after_uninstall(db, name)

    if removed:
        print(f"  ✅ Removed from {len(removed)} location(s):")
        for path in removed:
            print(f"     {path}")
    if remaining:
        print(f"  ⚠️  Retained {len(remaining)} protected/unverified tool installation(s): {', '.join(remaining)}")
        print("     Inspect them manually; their files and inventory were preserved.")
    elif not removed:
        print(f"  ⚠️  Spell \"{name}\" not found in local installation.")

    print()


def cmd_publish(args):
    """Publish a skill to the community registry."""
    path = Path(args.path).resolve()
    print(f"\n✨ Enchanting the community with: {path.name}...\n")

    skill_file = path / "skill.yaml" if path.is_dir() else path
    if not skill_file.exists():
        print(f"  ❌ No skill.yaml found at {skill_file}")
        print("  Create one with: skillforge init my-skill")
        return

    # Validate skill format
    from engine.registry import validate_skill_yaml
    errors = validate_skill_yaml(skill_file)
    if errors:
        print("  ❌ Validation errors:")
        for err in errors:
            print(f"     • {err}")
        return

    print("  ✅ Skill format valid")
    print("  📤 To publish, push your skill to a GitHub repo with topic: ai-skill")
    print("     The registry auto-indexes repos with this topic.")
    print()
    print("  Review copyright, credentials, and personal data before any publication.")
    print("  Publishing is a separate, manual, opt-in action; no repository is created here.")
    print()


def cmd_update(args):
    """Upgrade only unmodified files that SkillForge can verify as its own."""
    print("\n🔄 Checking for spell updates...\n")
    db = get_db()
    config = load_config()
    registry = Registry(db, config)
    installer = Installer(db, config)
    converter = ConverterEngine()

    installed = db.execute("SELECT name, version FROM installed_skills").fetchall()
    if not installed:
        print("  No spells installed. Nothing to update.")
        return

    updated = 0
    for name, current_version in installed:
        latest = registry.check_version(name)
        if not latest or latest == current_version:
            print(f"  ✅ {name}: up to date (v{current_version})")
            continue

        skill = registry.fetch(name)
        if not skill:
            print(f"  ⚠️  {name}: unable to fetch version {latest}; version unchanged")
            continue

        # Updates must target registered files, not newly detected tools.
        recorded_tools = [
            row[0] for row in db.execute(
                "SELECT tool FROM skill_files WHERE skill_name = ?", (name,)
            ).fetchall()
        ]
        tools = [tool for tool in recorded_tools if config.get("tools", {}).get(tool, True) is not False]
        if not tools:
            print(f"  ⚠️  {name}: no tracked tools to update; version unchanged")
            continue

        failures = []
        for tool in tools:
            try:
                content = converter.convert(skill, tool)
                installer.install(tool, name, content)
            except Exception as error:
                failures.append((tool, str(error)))

        if failures:
            print(f"  ⚠️  {name}: update partially blocked; version remains {current_version}")
            for tool, reason in failures:
                print(f"     {tool}: {reason}")
        else:
            registry.record_install(name, latest)
            updated += 1
            print(f"  ✅ {name}: v{current_version} → v{latest}")

    print(f"\n  {updated} spell(s) fully updated.")


def cmd_init(args):
    """Create a new skill from template."""
    name = args.name
    Installer._validate_name(name)
    skill_dir = Path.cwd() / name
    print(f"\n📝 Crafting new spell: {name}...\n")

    if skill_dir.exists():
        print(f"  ❌ Directory already exists: {skill_dir}")
        return

    # Load template
    template_path = FORGE_DIR / "templates" / "basic.skill"
    if template_path.exists():
        content = template_path.read_text(encoding="utf-8")
    else:
        content = _default_template()

    # Substitute name
    content = content.replace("{{name}}", name)
    content = content.replace("{{author}}", os.environ.get("USER", os.environ.get("USERNAME", "your-username")))

    skill_dir.mkdir(parents=True)
    (skill_dir / "skill.yaml").write_text(content, encoding="utf-8")

    print(f"  ✅ Created {skill_dir / 'skill.yaml'}")
    print()
    print("  Next steps:")
    print(f"     cd {name}")
    print("     # Edit skill.yaml with your skill content")
    print("     skillforge publish .")
    print()


def _default_template() -> str:
    return """name: {{name}}
version: 1.0.0
author: {{author}}
description: A powerful AI coding skill
tags: []
tools: [claude, codex, aider, qwen, gemini]
content:
  prompt: |
    Your skill prompt here.
    Describe what this skill teaches the AI agent to do.
  examples: []
  constraints: []
"""


# ── Main ──────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="skillforge",
        description="⚒️ SkillForge — The Universal AI Skill Package Manager",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            The Forge is lit. Craft your spells.

            Examples:
              skillforge search code-review     Search the grimoire
              skillforge install code-review    Install a spell
              skillforge list                   List installed spells
              skillforge update                 Update all spells
              skillforge init my-skill          Craft a new spell
              skillforge publish ./my-skill     Enchant the community
        """),
    )
    parser.add_argument("-v", "--version", action="version", version=f"skillforge {VERSION}")

    sub = parser.add_subparsers(dest="command", help="Command to execute")

    # search
    p_search = sub.add_parser("search", help="Search the grimoire for skills")
    p_search.add_argument("query", help="Search query")

    # install
    p_install = sub.add_parser("install", help="Install a skill into all AI tools")
    p_install.add_argument("skill", help="Skill name to install")

    # list
    sub.add_parser("list", help="List installed skills")

    # uninstall
    p_uninstall = sub.add_parser("uninstall", help="Remove a skill from all tools")
    p_uninstall.add_argument("skill", help="Skill name to remove")

    # publish
    p_publish = sub.add_parser("publish", help="Publish a skill to the registry")
    p_publish.add_argument("path", help="Path to skill directory or file")

    # update
    sub.add_parser("update", help="Update all installed skills")

    # init
    p_init = sub.add_parser("init", help="Create a new skill from template")
    p_init.add_argument("name", help="Name for the new skill")

    args = parser.parse_args()

    if not args.command:
        print_banner()
        parser.print_help()
        return

    commands = {
        "search": cmd_search,
        "install": cmd_install,
        "list": cmd_list,
        "uninstall": cmd_uninstall,
        "publish": cmd_publish,
        "update": cmd_update,
        "init": cmd_init,
    }

    try:
        commands[args.command](args)
    except KeyboardInterrupt:
        print("\n  Cancelled.")
        sys.exit(1)
    except Exception as e:
        print(f"\n  ❌ Error: {e}")
        if os.environ.get("SKILLFORGE_DEBUG"):
            import traceback
            traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
